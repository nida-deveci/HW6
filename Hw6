enum FuelType
{
    Petrol,
    Diesel,
    Electric
}

class Vehicle
{
    public string Brand { get; set; }
    public string Model { get; set; }
    public int Year { get; set; }
    public FuelType Fuel { get; set; }

    public static int Count = 0;

  
    public Vehicle(string brand, string model, int year, FuelType fuel)
    {
        Brand = brand;
        Model = model;
        Year = year;
        Fuel = fuel;
        Count++;
    }

 
    public virtual void StartEngine()
    {
        Console.WriteLine("The vehicle's engine is starting...");
    }

 
    public string Info()
    {
        return $"{Brand} {Model} ({Year}, {Fuel})";
    }
}


class Car : Vehicle
{
    public Car(string brand, string model, int year, FuelType fuel)
        : base(brand, model, year, fuel)
    {
    }

    public override void StartEngine()
    {
        Console.WriteLine("Car: Engine started with the push of a button. Vroom!");
    }
}

class Truck : Vehicle
{
    public Truck(string brand, string model, int year, FuelType fuel)
        : base(brand, model, year, fuel)
    {
    }

    public override void StartEngine()
    {
        Console.WriteLine("Truck: Heavy diesel engine rumbles to life. Brrrrmm!");
    }
}

class Motorcycle : Vehicle
{
    public Motorcycle(string brand, string model, int year, FuelType fuel)
        : base(brand, model, year, fuel)
    {
    }

    public override void StartEngine()
    {
        Console.WriteLine("Motorcycle: Engine roars after a kick start. Ring-ding-ding!");
    }
}

class Program
{
    static void Main(string[] args)
    {
      
        Vehicle[] fleet = new Vehicle[]
        {
            new Car("Togg", "T10X", 2024, FuelType.Electric),
            new Truck("Ford", "F-Max", 2022, FuelType.Diesel),
            new Motorcycle("Yamaha", "MT-07", 2023, FuelType.Petrol)
        };

        
        foreach (Vehicle v in fleet)
        {
            Console.WriteLine(v.Info());
            v.StartEngine();
            Console.WriteLine();
        }

        Console.WriteLine($"Total vehicles created: {Vehicle.Count}");
    }
}
